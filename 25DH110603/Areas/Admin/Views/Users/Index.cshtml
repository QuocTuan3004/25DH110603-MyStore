@model IEnumerable<_25DH110603.Models.User>
@{ ViewBag.Title = "Tài khoản quản trị"; Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; }
<h2>Tài khoản quản trị</h2>
<p>@Html.ActionLink("Thêm tài khoản", "Create", null, new { @class = "btn btn-primary" })</p>
<table class="table table-striped"><thead><tr><th>Tên đăng nhập</th><th>Vai trò</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.Username</td><td>Quản trị</td><td>@Html.ActionLink("Sửa", "Edit", new { id = item.Username }, new { @class = "btn btn-primary btn-sm" }) @Html.ActionLink("Xóa", "Delete", new { id = item.Username }, new { @class = "btn btn-danger btn-sm" })</td></tr> }
</tbody></table>
