<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Quản trị WEBSITE </title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            @Html.ActionLink("My Store", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li>@Html.ActionLink("Home", "Index", "Home")</li>
                    <li class="nav-item dropdown"><a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Quản lý danh mục</a><ul class="dropdown-menu"><li>@Html.ActionLink("Danh sách danh mục", "Index", "Categories", new { area = "Admin" }, new { @class = "dropdown-item" })</li><li>@Html.ActionLink("Thêm danh mục", "Create", "Categories", new { area = "Admin" }, new { @class = "dropdown-item" })</li></ul></li>
                    <li class="nav-item dropdown"><a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Quản lý hàng hóa</a><ul class="dropdown-menu"><li>@Html.ActionLink("Danh sách sản phẩm", "Index", "Products", new { area = "Admin" }, new { @class = "dropdown-item" })</li><li>@Html.ActionLink("Thêm sản phẩm", "Create", "Products", new { area = "Admin" }, new { @class = "dropdown-item" })</li><li>@Html.ActionLink("Quản lý kho hàng", "Inventory", "Products", new { area = "Admin" }, new { @class = "dropdown-item" })</li></ul></li>
                    <li>@Html.ActionLink("Khách hàng", "Index", "Customers", new { area = "Admin" }, null)</li>
                    <li>@Html.ActionLink("Đơn hàng", "Index", "Orders", new { area = "Admin" }, null)</li>
                    <li>@Html.ActionLink("Tài khoản", "Index", "Users", new { area = "Admin" }, null)</li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Website bán hàng </p>
            <h4>Contact</h4>
            <p>Đinh Quốc Tuấn</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
