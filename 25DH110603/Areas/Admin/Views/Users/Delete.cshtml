@model _25DH110603.Models.User
@{ ViewBag.Title = "Xóa tài khoản quản trị"; Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; }
<h2>Xóa tài khoản quản trị</h2>
@Html.ValidationSummary(false, "", new { @class = "text-danger" })
<p>Bạn có chắc muốn xóa tài khoản <strong>@Model.Username</strong>?</p>
@using (Html.BeginForm("Delete", "Users", new { id = Model.Username }, FormMethod.Post)) { @Html.AntiForgeryToken() <button class="btn btn-danger" type="submit">Xóa</button> @Html.ActionLink("Hủy", "Index", null, new { @class = "btn btn-secondary" }) }
