@model _25DH110603.Models.ViewModel.HomeProductVM
@using PagedList.Mvc
@{
    ViewBag.Title = "Trang chủ";
}
<section class="hero-panel">
    <div><p class="eyebrow">MY STORE</p><h1 class="hero-title">1 ngày dài mệt mỏi? hãy xem phim <span class="hero-highlight">ngay.</span></h1></div>
    @using (Html.BeginForm("Index", "Home", FormMethod.Get, new { @class = "search-form" }))
    {
        @Html.TextBox("searchTerm", Model.SearchTerm, new { @class = "form-control", placeholder = "Tìm theo tên, mô tả hoặc danh mục…", aria_label = "Tìm sản phẩm" })
        <button class="btn btn-primary" type="submit">Tìm kiếm</button>
    }
</section>
@if (TempData["Message"] != null) { <div class="alert alert-success">@TempData["Message"]</div> }
<section class="product-section">
    <div class="section-heading"><div><p class="eyebrow">ĐƯỢC QUAN TÂM</p><h2>Sản phẩm nổi bật</h2></div></div>
    @Html.Partial("_PVFeatureProduct", Model.FeaturedProducts)
</section>
<section class="product-section">
    <div class="section-heading"><div><p class="eyebrow">GỢI Ý CHO BẠN</p><h2>@(String.IsNullOrWhiteSpace(Model.SearchTerm) ? "Sản phẩm mới" : "Kết quả tìm kiếm")</h2></div><span>@Model.NewestProducts.TotalItemCount sản phẩm</span></div>
    @Html.Partial("_PVNewProduct", Model.NewestProducts)
    @Html.PagedListPager(Model.NewestProducts, page => Url.Action("Index", new { searchTerm = Model.SearchTerm, page }), PagedListRenderOptions.ClassicPlusFirstAndLast)
</section>
