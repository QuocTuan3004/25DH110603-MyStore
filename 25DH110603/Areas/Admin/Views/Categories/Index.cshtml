@model IEnumerable<_25DH110603.Models.Category>
@{ ViewBag.Title = "Danh mục"; Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; }
<h2 class="bg-success">DANH SÁCH DANH MỤC SẢN PHẨM</h2>
<table class="table bg-info">
    <thead><tr><th>Tên danh mục</th><th>Số lượng sản phẩm</th><th>Thao tác</th></tr></thead>
    <tbody>
    @foreach (var item in Model) {
        <tr><td>@Html.DisplayFor(_ => item.CategoryName)</td><td>@item.Products.Count</td><td>
            @Html.ActionLink("Chi tiết", "Details", new { id = item.CategoryID }, new { @class = "btn btn-secondary btn-sm" })
            @Html.ActionLink("Sửa", "Edit", new { id = item.CategoryID }, new { @class = "btn btn-primary btn-sm" })
            @Html.ActionLink("Xóa", "Delete", new { id = item.CategoryID }, new { @class = "btn btn-danger btn-sm" })
        </td></tr>
    }
    </tbody>
</table>
@Html.ActionLink("Thêm danh mục", "Create", null, new { @class = "btn btn-primary" })
