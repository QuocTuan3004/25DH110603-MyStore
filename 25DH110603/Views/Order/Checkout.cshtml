@model _25DH110603.Models.ViewModel.CheckoutVM
@{ ViewBag.Title = "Thanh toán"; var cart = new _25DH110603.Models.ViewModel.CartService(Session).GetCart(); }
<section class="page-heading"><p class="eyebrow">BƯỚC CUỐI</p><h1>Thanh toán</h1></section>
<div class="checkout-grid"><section class="form-card"><h2>Thông tin nhận hàng</h2>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken() @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="form-group">@Html.LabelFor(m => m.ShippingAddress) @Html.TextBoxFor(m => m.ShippingAddress, new { @class = "form-control", required = "required" }) @Html.ValidationMessageFor(m => m.ShippingAddress, "", new { @class = "text-danger" })</div>
    <div class="form-group">@Html.LabelFor(m => m.DeliveryMethod) @Html.DropDownListFor(m => m.DeliveryMethod, new SelectList(new[] { "Tiêu chuẩn", "Giao hàng nhanh" }, Model.DeliveryMethod), new { @class = "form-control" })</div>
    <div class="form-group">@Html.LabelFor(m => m.PaymentMethod) @Html.DropDownListFor(m => m.PaymentMethod, new SelectList(new[] { "Thanh toán khi nhận hàng", "Chuyển khoản" }, Model.PaymentMethod), new { @class = "form-control" })</div>
    <button type="submit" class="btn btn-primary btn-lg">Đặt hàng</button>
}
</section><aside class="cart-summary"><h2>Đơn hàng</h2>
@foreach (var item in cart.Items) { <div class="summary-row"><span>@item.ProductName × @item.Quantity</span><span>@item.LineTotal.ToString("N0") ₫</span></div> }
<div class="summary-row summary-total"><span>Tổng cộng</span><strong>@cart.Total.ToString("N0") ₫</strong></div>
</aside></div>
