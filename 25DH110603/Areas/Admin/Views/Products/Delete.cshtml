@model _25DH110603.Models.Product

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">Xóa sản phẩm?</h2>

<div>Bạn thực sự muốn xóa sản phẩm này?</div>
@Html.ValidationSummary(false, "", new { @class = "text-danger" })

@Html.Partial("PVInfoProduct", Model)
<div style="padding:10px">
    @using (Html.BeginForm("Delete", "Products", new { id = Model.ProductID }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-primary btn-sm">Xóa</button>
        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary btn-sm" })
    }
</div>