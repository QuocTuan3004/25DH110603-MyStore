@model IEnumerable<_25DH110603.Models.Customer>
@{ ViewBag.Title = "Khách hàng"; Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; }
<h2>Danh sách khách hàng</h2>
<table class="table table-striped"><thead><tr><th>Khách hàng</th><th>Điện thoại</th><th>Email</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.CustomerName</td><td>@item.CustomerPhone</td><td>@item.CustomerEmail</td><td>@Html.ActionLink("Chi tiết", "Details", new { id = item.CustomerID }, new { @class = "btn btn-outline-primary btn-sm" })</td></tr> }
</tbody></table>
