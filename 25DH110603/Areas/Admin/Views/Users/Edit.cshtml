@model _25DH110603.Models.ViewModel.AdminUserVM
@{ ViewBag.Title = "Sửa tài khoản quản trị"; Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; }
<h2>Sửa tài khoản quản trị</h2>
@using (Html.BeginForm()) { @Html.AntiForgeryToken() @Html.HiddenFor(m => m.OriginalUsername) @Html.ValidationSummary(false, "", new { @class = "text-danger" })
<div class="form-group">@Html.LabelFor(m => m.Username) @Html.TextBoxFor(m => m.Username, new { @class = "form-control" }) @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })</div>
<div class="form-group">@Html.LabelFor(m => m.Password) <span>(để trống nếu không đổi)</span> @Html.PasswordFor(m => m.Password, new { @class = "form-control" }) @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })</div>
<button class="btn btn-primary" type="submit">Lưu thay đổi</button> @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-secondary" }) }
