@model _25DH110603.Models.Category
@{ ViewBag.Title = "Chi tiết danh mục"; Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; }
<h2 class="bg-success">CHI TIẾT DANH MỤC</h2>
<section class="card p-3 mb-3"><h3>@Model.CategoryName</h3><p>Số sản phẩm: @Model.Products.Count</p></section>
<h3>Sản phẩm thuộc danh mục</h3>
@if (!Model.Products.Any()) { <p>Danh mục này chưa có sản phẩm.</p> }
else {
    <table class="table table-striped"><thead><tr><th>Tên sản phẩm</th><th>Đơn giá</th><th>Thao tác</th></tr></thead><tbody>
    @foreach (var product in Model.Products) {
        <tr><td>@product.ProductName</td><td>@product.ProductPrice.ToString("N0")</td><td>@Html.ActionLink("Xem sản phẩm", "Details", "Products", new { area = "Admin", id = product.ProductID }, new { @class = "btn btn-outline-primary btn-sm" })</td></tr>
    }
    </tbody></table>
}
@Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary" })
