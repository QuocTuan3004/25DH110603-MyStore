@model _25DH110603.Models.ViewModel.ProductSearchVM
@using PagedList.Mvc;
<head>
    <style>
        img {
            height: 150px;
            max-width: 150px
        }
    </style>
</head>

@if (Model.Products != null && Model.Products.Any())
{
    <h2 class="bg-success">DANH SÁCH SẢN PHẨM</h2>


    <table class="table bg-info ">
        <thead>
            <tr>
                <th class="bg-success col-md-2">Hình ảnh</th>
                <th class="bg-success col-md-2">Tên sản phẩm </th>
                <th class="bg-success col-md-1">Đơn giá</th>
                <th class="bg-success col-md-1">Tồn kho</th>
                <th class="bg-success col-md-2">Danh mục</th>
                <th class="bg-success col-md-4"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Products)
            {
                <tr>
                    <td><img src="@Url.Content(String.IsNullOrWhiteSpace(item.ProductImage) ? "~/Content/no-image.png" : item.ProductImage)" alt="@item.ProductName" style="max-width:100px;max-height:80px;object-fit:cover" /></td>
                    <td>@Html.DisplayFor(modelItem => item.ProductName)</td>
                    <td>@Html.DisplayFor(modelItem => item.ProductPrice)</td>
                    <td>@item.Quantity</td>
                    <td>@Html.DisplayFor(modelItem => item.Category.CategoryName)</td>
                    <td>
                        @Html.ActionLink("Sửa", "Edit", new { id = item.ProductID }, new { @class = "btn btn-primary btn-sm" })
                        @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }, new { @class = "btn btn-primary btn-sm" })
                        @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID }, new { @class = "btn btn-primary btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Hiển thị phân trang -->
<div class="pagination-container">
    @Html.PagedListPager(Model.Products, page => Url.Action("Index", new { page, searchTerm = Model.SearchTerm,
    minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = Model.SortOrder }))
</div>
}
else
{
    <p>Không tìm được sản phẩm phù hợp.</p>
}
<div class="form-group">
    <div class="col-md-offset-8 col-md-4">
        @Html.ActionLink("Thêm sản phẩm mới", "Create", null, new { @class = "btn btn-primary btn-sm" })
    </div>
</div>
