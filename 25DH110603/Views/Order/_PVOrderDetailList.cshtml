@model IEnumerable<_25DH110603.Models.OrderDetail>
<div class="table-responsive"><table class="table"><thead><tr><th>Sản phẩm</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead><tbody>
@foreach (var detail in Model) { <tr><td>@(detail.Product == null ? "(Sản phẩm không còn trong danh mục)" : detail.Product.ProductName)</td><td>@detail.Quantity</td><td>@detail.UnitPrice.ToString("N0") ₫</td><td>@detail.TotalPrice.ToString("N0") ₫</td></tr> }
</tbody></table></div>
